[Unit]
Description=JoDerma Staff Ops (Django + Gunicorn)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=notify
User=joderma
Group=joderma
WorkingDirectory=/opt/joderma-staff-ops
EnvironmentFile=/opt/joderma-staff-ops/.env
ExecStartPre=/opt/joderma-staff-ops/.venv/bin/python manage.py migrate --noinput
ExecStart=/opt/joderma-staff-ops/.venv/bin/gunicorn -c gunicorn.conf.py config.wsgi:application
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/joderma-staff-ops/data /opt/joderma-staff-ops/private_media /opt/joderma-staff-ops/logs /opt/joderma-staff-ops/backups
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Aplikasi hanya perlu loopback; Tailscale Serve yang menjembatani.
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
