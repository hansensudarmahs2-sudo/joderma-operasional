# Salin menjadi .env dan isi. JANGAN commit file .env.
DJANGO_SECRET_KEY=ganti-dengan-nilai-acak-panjang
DJANGO_DEBUG=false
# Hostname MagicDNS Tailscale, mis. joderma-ops.tailnet-xxxx.ts.net
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,joderma-ops.CONTOH.ts.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://joderma-ops.CONTOH.ts.net

DJANGO_DB_PATH=/app/data/db.sqlite3
DJANGO_MEDIA_ROOT=/app/private_media

SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
ATTACHMENT_MAX_BYTES=5242880
LOG_LEVEL=INFO

# Kunci enkripsi backup (buat sekali, simpan di brankas terpisah dari server)
BACKUP_PASSPHRASE=
